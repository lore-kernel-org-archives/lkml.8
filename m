 	ARM64_FTR_BITS(FTR_HIDDEN, FTR_STRICT, FTR_LOWER_SAFE, ID_AA64DFR0_WRPS_SHIFT, 4, 0),
@@ -332,14 +332,14 @@ static const struct arm64_ftr_bits ftr_id_aa64dfr0[] = {
 };
 
